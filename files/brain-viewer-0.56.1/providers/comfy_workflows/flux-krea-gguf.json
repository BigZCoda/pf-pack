{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "{{unet}}"
    },
    "_meta": {"title": "the diffusion model, 4-bit GGUF (ComfyUI-GGUF)"}
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "{{t5}}",
      "clip_name2": "{{clip_l}}",
      "type": "flux"
    },
    "_meta": {"title": "the two text encoders, T5-XXL and CLIP-L"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "_meta": {"title": "the Flux VAE"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["2", 0]
    },
    "_meta": {"title": "the prompt"}
  },
  "5": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["4", 0],
      "guidance": "{{guidance}}"
    },
    "_meta": {"title": "Flux's distilled guidance"}
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["4", 0]
    },
    "_meta": {"title": "the negative KSampler requires; unused at cfg 1.0, Flux has no negative prompt"}
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    },
    "_meta": {"title": "the empty 16-channel latent"}
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    },
    "_meta": {"title": "the sampler"}
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    },
    "_meta": {"title": "latent to pixels"}
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "brain-studio"
    },
    "_meta": {"title": "the picture the provider fetches with /view"}
  }
}
